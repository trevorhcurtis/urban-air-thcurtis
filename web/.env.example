# Copy to .env.local and adjust. Never commit real secrets.

# Server-only base URL for the PHP API (no trailing slash).
API_BASE_URL=http://127.0.0.1:8080

# Signs the session and trips cookies. Must be at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Shared with the PHP API (API_PROXY_SECRET in api/.env). Required in production so only this app can call the API.
# Leave unset in local development.
API_PROXY_SECRET=replace-with-a-different-random-string-at-least-32-chars
