{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbanair.example/schema/component.schema.json",
  "title": "Urban Air component contract",
  "description": "Describes one primitive: its source file, the values each prop accepts, and the states it implements. Contracts live next to the component as <Name>.contract.json. components/ui/contracts.test.tsx checks them against the exported variant lists.",
  "type": "object",
  "required": ["name", "source", "props", "states"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^components/" },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["values"],
        "additionalProperties": false,
        "properties": {
          "values": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "default": { "type": "string" }
        }
      }
    },
    "states": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "keyboard": { "type": "string" },
    "touch": { "type": "string" },
    "notes": { "type": "string" }
  }
}
