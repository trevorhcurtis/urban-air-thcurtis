{
    "name": "urbanair/api",
    "description": "Urban Air prototype JSON API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "UrbanAir\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "UrbanAir\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
